# RM MCP Server — Variáveis de ambiente obrigatórias
# Copiar para .env e preencher com valores reais
# Cada variável SEM sufixo = TESTE, com _PROD = PRODUÇÃO

# === TESTE ===
RM_SQL_CONNECTION=Server=MIP09\TESTE;Database=Corpore;Integrated Security=true;TrustServerCertificate=true
RM_SOAP_URL=http://svrteste.fluig.mip.com.br:8051
RM_SOAP_USER=
RM_SOAP_PASS=

# === PRODUÇÃO ===
RM_SQL_CONNECTION_PROD=Server=MIP09;Database=Corpore;Integrated Security=true;TrustServerCertificate=true
RM_SOAP_URL_PROD=http://SERVIDOR_PROD:8051
RM_SOAP_USER_PROD=
RM_SOAP_PASS_PROD=
